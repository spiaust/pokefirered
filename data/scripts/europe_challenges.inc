@ Called by secondary-town guides while the field is locked.
EuropeChallenge_Complete::
	msgbox EuropeChallenge_Text_Complete
	release
	end
EuropeChallenge_BagFull::
	msgbox EuropeChallenge_Text_BagFull
	release
	end
EuropeChallenge_Text_Reward::
	.string "Both regional matches completed!\n"
	.string "You've earned one RARE CANDY.$"
EuropeChallenge_Text_Complete::
	.string "Your regional challenge is complete!\n"
	.string "Your RARE CANDY has been claimed.\p"
	.string "Each country has two trail trainers.\n"
	.string "Visit the other town guides, too!\p"
	.string "Other guides: OXFORD, CHANTILLY,\n"
	.string "and ORANIENBURG.\p"
	.string "Station: east side of the square.\n"
	.string "Book a train to your next guide town.$"
EuropeChallenge_Text_BagFull::
	.string "Both wins are recorded, but your\n"
	.string "BAG's ITEMS pocket is full.\p"
	.string "Make room and return here.\n"
	.string "Your RARE CANDY will be waiting!\p"
	.string "Open BAG, then the ITEMS pocket.\n"
	.string "Use, give or toss an unneeded item.\p"
	.string "Return here after making room.\n"
	.string "Your reward will still be waiting!$"
